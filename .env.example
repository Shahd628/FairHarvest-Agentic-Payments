# Copy this file to .env and fill in your values. Never commit .env to git.

# Infura project token for Sepolia RPC access
INFURA_TOKEN=your_infura_token_here

# Agent wallet private key (holds Sepolia ETH for gas only)
# To generate a fresh wallet: w3.eth.account.create()
WALLET_PRIVATE_KEY=0x_your_private_key_here

# Farmer's wallet address (whose policy and deals the agent manages)
FARMER_ADDRESS=0x_farmer_wallet_address

# Deployed contract addresses on Sepolia (set once contracts are deployed)
TRADE_CONTRACT_ADDRESS=0x_trade_contract_address
ORACLE_CONTRACT_ADDRESS=0x_oracle_contract_address

# Optional tuning parameters
POLL_INTERVAL=30        # seconds between block polls (default: 30)
TARGET_RATIO=95         # fallback counter as % of oracle price if LLM unavailable (default: 95)
LLM_MODEL=claude-haiku-4-5-20251001   # Claude model for decisions (default: haiku for low latency)
